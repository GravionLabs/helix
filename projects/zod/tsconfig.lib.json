{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/helix-zod-lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    "paths": {
      "@gravionlabs/helix-shell": ["../../dist/shell"],
      "@gravionlabs/helix-core": ["../../dist/core"],
      "@gravionlabs/helix-core/*": ["../../dist/core/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
