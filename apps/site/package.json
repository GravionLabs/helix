{
  "name": "@helix/site",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site: docs/ as a website (VitePress), published with the demo on GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit-site.xml",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  }
}
