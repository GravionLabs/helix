{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "implementer result",
  "type": "object",
  "required": ["status", "commit", "filesChanged", "testsRun", "notes"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["done", "blocked"] },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "filesChanged": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testsRun": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "done" } } },
      "then": {
        "properties": { "commit": { "type": "string" }, "filesChanged": { "type": "array", "minItems": 1 }, "testsRun": { "type": "string", "minLength": 1 } }
      },
      "else": {
        "properties": { "notes": { "type": "array", "minItems": 1 } }
      }
    }
  ]
}
